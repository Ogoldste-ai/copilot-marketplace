{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copilot Marketplace Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "type", "trigger", "owner", "version", "status", "source"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["skill", "instruction", "agent"] },
    "trigger": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owner": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "review", "published", "deprecated"] },
    "source": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "object",
      "properties": {
        "network": { "type": "boolean" },
        "filesystem": { "type": "string", "enum": ["read-only", "workspace-write", "full"] }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "approvers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
